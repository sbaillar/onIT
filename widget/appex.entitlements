<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widget extensions must be sandboxed. The app has no Apple Developer
	     Team ID (self-created cert), so App Groups are off the table; the
	     read-only home-relative exception opens exactly the one directory
	     where the app drops widget-state.json. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/onIT/</string>
	</array>
</dict>
</plist>
